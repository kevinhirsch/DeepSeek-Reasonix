{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "reasonix-desktop",
  "outputfilename": "reasonix-desktop",
  "frontend:install": "pnpm install",
  "frontend:build": "pnpm build",
  "frontend:dev:watcher": "pnpm dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "kevinhirsch"
  },
  "info": {
    "companyName": "Reasonix",
    "productName": "Reasonix",
    "productVersion": "2.0.0",
    "copyright": "Copyright © 2026 Reasonix Contributors",
    "comments": "Reasonix desktop — DeepSeek-native AI coding agent."
  },
  "nsis": {
    "installDirectory": "$PROGRAMFILES\\Reasonix",
    "uninstallDisplayName": "Reasonix Desktop",
    "license": "..\\LICENSE",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Reasonix"
  }
}
